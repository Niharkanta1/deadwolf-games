# Environment Variables Example
# Copy this to .env.local and fill in your actual values

# Site Configuration
VITE_SITE_TITLE=Deadwolf Games
VITE_SITE_URL=https://yourdomain.com

# Google Maps API Key (if using interactive map)
VITE_GOOGLE_MAPS_API_KEY=YOUR_API_KEY_HERE

# Google Analytics ID (optional)
VITE_GA_ID=

# Contact Email
VITE_CONTACT_EMAIL=contact@deadwolfgames.com

# Social Media URLs
VITE_TWITTER_URL=https://twitter.com
VITE_GITHUB_URL=https://github.com
VITE_YOUTUBE_URL=https://youtube.com
VITE_DISCORD_URL=https://discord.com
VITE_INSTAGRAM_URL=https://instagram.com
VITE_LINKEDIN_URL=https://linkedin.com
